{erl_opts, [debug_info]}.
{src, ["src", "src/mymcp"]}.
{deps, [
    {cowboy, "2.12.0"},
    {jsx, "3.1.0"},
    {jesse, "1.8.2"}
]}.
{shell, [
    {apps, [emcp]},
    {config, "./config/sys.config"}
]}.
{profiles, [
    {test, [
        {cover_enabled, true},
        {cover_export_enabled, true}
    ]}
]}.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    exports_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
